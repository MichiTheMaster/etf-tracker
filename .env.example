MYSQL_DATABASE=etftracker
MYSQL_USER=etfuser
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
# Mindestens 32 Zeichen, kein Platzhalter. Beispiel erzeugen: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1,http://localhost:8088,http://127.0.0.1:8088,http://192.168.*.*:3000,http://192.168.*.*:8088,http://192.168.*.*:8081,http://10.*.*.*:3000,http://10.*.*.*:8088
APP_COOKIE_SECURE=false
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_EMAIL_VERIFICATION_REQUIRED=false
APP_EMAIL_VERIFICATION_TOKEN_VALID_HOURS=24
APP_MAIL_FROM=no-reply@etf-tracker.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# Für HTTPS/Internet-Betrieb:
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://DEINE-DOMAIN
# APP_COOKIE_SECURE=true
